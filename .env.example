# Скопіюй цей файл у .env.local і встав свої значення з Supabase:
# Project Settings -> API (або кнопка Connect) -> Project URL і anon / publishable key
# ВАЖЛИВО: назви мають починатися з VITE_ (не NEXT_PUBLIC_), інакше Vite їх не побачить
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
